# Copy to .env.local for local development. On Vercel add these under
# Project → Settings → Environment Variables.

# ---------- Required ----------
# Agora Console → your project → Manage credentials → Primary certificate.
# Server-side only — never put it in the Flutter app or in NEXT_PUBLIC_* variables.
AGORA_APP_CERTIFICATE=

# ---------- Database ----------
# Vercel: Storage → Create Database → Neon → Connect. This sets DATABASE_URL for you.
# Leave empty locally / on a VPS: an embedded Postgres (PGlite) stores data in ./data/pglite.
DATABASE_URL=

# ---------- Optional ----------
# Agora App ID (not secret). Defaults to the project's App ID in src/lib/config.ts.
# AGORA_APP_ID=91a5d012fb4b490b94732cf3b1371a95
# AGORA_TOKEN_TTL=3600
# Owner dashboard PIN (default 0000)
# ADMIN_PIN=0000
# Signs staff logins. Defaults to a value derived from the Agora certificate.
# SESSION_SECRET=
# "Today" in reports uses this time zone
# APP_TIMEZONE=Asia/Kolkata
