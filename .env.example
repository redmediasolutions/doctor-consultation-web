# Copy to .env.local for local development. On Vercel add these under
# Project → Settings → Environment Variables. All of these are public client
# values (same as the Gladskin admin app) — no secrets in this project.

# ---------- Backend (Gladskin Node.js API) ----------
# MedConnect routes live under /api/tele on the same server.
NEXT_PUBLIC_API_BASE_URL=https://api-12v1.gladskin.in/api

# ---------- Firebase client (same project as Gladskin) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ---------- OTP login (MSG91 cloud functions, same as Gladskin) ----------
NEXT_PUBLIC_FIREBASE_OTP_SEND_URL=
NEXT_PUBLIC_FIREBASE_OTP_VERIFY_URL=

# ---------- Optional ----------
# Agora App ID (not secret). Defaults to the project's App ID in src/lib/config.ts.
# NEXT_PUBLIC_AGORA_APP_ID=91a5d012fb4b490b94732cf3b1371a95
# Show [AUTH] logs in the browser console on production builds
# NEXT_PUBLIC_AUTH_DEBUG=true
